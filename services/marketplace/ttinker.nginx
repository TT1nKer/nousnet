server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ttinker.net www.ttinker.net;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/ttinker/acme;
        default_type text/plain;
    }

    location / {
        return 301 https://ttinker.net$request_uri;
    }
}

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name ttinker.net www.ttinker.net;
    server_tokens off;

    if ($host = www.ttinker.net) {
        return 301 https://ttinker.net$request_uri;
    }

    ssl_certificate /etc/letsencrypt/live/ttinker.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ttinker.net/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header Strict-Transport-Security "max-age=31536000" always;

    root /var/www/ttinker/site/current;
    index index.html;

    location = / {
        try_files /index.html =404;
        access_log off;

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
    }

    location = /grid {
        return 302 /grid/;
    }

    location ^~ /grid/api/ {
        proxy_pass http://127.0.0.1:8092/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        proxy_hide_header Cache-Control;
        proxy_hide_header X-Content-Type-Options;
        client_max_body_size 16k;
        access_log off;
        limit_except GET POST { deny all; }

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location = /grid/downloads/agent.py {
        alias /opt/ttinker-grid/current/agent.py;
        default_type text/x-python;
        access_log off;
        limit_except GET { deny all; }

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "no-cache" always;
        add_header Content-Disposition "attachment; filename=ttinker-grid-agent.py" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location ^~ /grid/ {
        alias /var/www/ttinker/grid/current/;
        index index.html;
        access_log off;
        limit_except GET { deny all; }

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
    }

    location = /chatcommons {
        return 302 /chatcommons/;
    }

    location ^~ /chatcommons/api/ {
        proxy_pass http://127.0.0.1:8091/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 15s;
        client_max_body_size 2m;
        access_log off;

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location ~ ^/chatcommons/(?<chatcommons_asset>(?!.*\.\.)[A-Za-z0-9_./-]+\.(?:css|js|png|jpe?g|svg|webp|woff2?))$ {
        alias /var/www/ttinker/chatcommons/current/public/$chatcommons_asset;
        access_log off;
        limit_except GET { deny all; }

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "public, max-age=604800" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location /chatcommons/ {
        alias /var/www/ttinker/chatcommons/current/public/;
        index index.html;
        access_log off;
        limit_except GET { deny all; }

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    }

    location = /motion-lab {
        return 302 /motion-lab/;
    }

    location ^~ /motion-lab/ {
        alias /var/www/ttinker/motion-lab/current/;
        index index.html;
        access_log off;
        limit_except GET { deny all; }

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
    }

    include /etc/nginx/snippets/avatar-demo.conf;

    location / {
        try_files $uri $uri/ =404;
        access_log off;
        limit_except GET { deny all; }

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "public, max-age=604800" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}
